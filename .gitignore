# Allow-list: everything is ignored except the paths re-included below.
# Literature, project documentation, figures, raw photos and personal files stay local.
/*
!/.gitignore
!/.github/
!/LICENSE
!/LICENSE-DATA.md
!/CITATION.cff

# Thesis LaTeX source (no CV, no compiled PDF)
!/01_Thesis/
/01_Thesis/*
!/01_Thesis/LaTeX_Source/
/01_Thesis/LaTeX_Source/CV/

# Experimental data (WFE runs, silencer effect, TFA, summaries)
!/03_Experimental_Data/

# CAD geometries of the fluid domains
!/04_CAD_Geometry/

# CFD simulation reports (ANSYS screenshots and the SharePoint shortcut stay local)
!/05_CFD_Simulation/
/05_CFD_Simulation/*
!/05_CFD_Simulation/Report_Data/

# Analysis scripts
!/06_Analysis_Scripts/
/06_Analysis_Scripts/raw_commands/

# Machine learning datasets and scripts (old versions stay local)
!/07_Machine_Learning_PIML/
/07_Machine_Learning_PIML/MATLAB_PIML/Old/

# Straightness analysis: code and results only, no raw photos
!/08_Straightness_Analysis/
/08_Straightness_Analysis/WFE Straightness Photos/
/08_Straightness_Analysis/More_Photos/
/08_Straightness_Analysis/**/*.HEIC
/08_Straightness_Analysis/**/*.heic
/08_Straightness_Analysis/**/*.JPG
/08_Straightness_Analysis/**/*.jpg
/08_Straightness_Analysis/**/*.jpeg

# Everywhere
.DS_Store
~$*
__pycache__/
*.pyc
*.asv
*.zip
.cache/
